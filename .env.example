# Configuración local del estudiante / autor
# Copia este archivo como .env (cp .env.example .env) y completa tus datos.
# El archivo .env real permanece siempre fuera del control de versiones (.gitignore).

# Datos obligatorios para portadas y nomenclatura de entregables
NOMBRE_ESTUDIANTE="Ana Perez"
INSTITUCION="Universidad Ejemplo"
CARRERA="Ingenieria de Software"

# Sufijo para entregables individuales: <CODIGO>_<Titulo>_<SUFIJO_ARCHIVOS>.docx
SUFIJO_ARCHIVOS="Perez_Ana"

# Opciones de formato y exportación (opcionales)
# Presets oficiales: apa7, paper (o nombre/ruta a un theme.json en themes/ o themes/local/)
TEMA_DEFECTO="apa7"
# Estilo de tablas por defecto: apa (3 líneas APA 7) o grid (cuadrícula completa)
ESTILO_TABLA="apa"
# Copiar automáticamente el PDF final a la carpeta Descargas/Downloads del sistema (false por defecto)
COPIAR_PDF_DESCARGAS="false"

# Configuración de equipo (opcional: para tareas grupales cuando no se definen en TAREA.md)
# GRUPO_DEFECTO="Grupo 1"
# INTEGRANTES_DEFECTO="Ana Perez, Luis Gomez, Sofia Martinez"
